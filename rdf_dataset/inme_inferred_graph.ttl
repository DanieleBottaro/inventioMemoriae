:napoleone_orsini a crm:E21_Person,
        owl:NamedIndividual,
        rico:Person ;
    rdfs:label "Napoleone Orsini"@en,
        "Napoleone Orsini"@it ;
    dcterms:description "A young Roman count and nephew of Cardinal Stefano di Fossanova; he died in Rome following a disastrous fall from his horse in 1221 and was miraculously restored to life by Saint Dominic, an event carved onto the side of the Arca."@en,
        "Giovane conte romano, nipote del cardinale Stefano di Fossanova; morì a Roma in seguito a una rovinosa caduta da cavallo nel 1221 e fu miracolosamente risuscitato da san Domenico, evento testimoniato direttamente da suor Cecilia e scolpito sul fianco dell'Arca."@it ;
    crm:P11i_participated_in :orsini_horse_fall ;
    crm:P129i_is_subject_of :legenda_constantini,
