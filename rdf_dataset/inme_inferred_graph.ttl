:humbert_romans a crm:E21_Person,
        owl:NamedIndividual,
        rico:Person ;
    rdfs:label "Humbert of Romans"@en,
        "Umberto di Romans"@it ;
    dcterms:description "Fifth Master General of the Order (1254–1263); he reorganized and unified the Dominican liturgy by compiling the liturgical \"Prototype\" (1256–1260), promoted the writing of the *Vitae fratrum* by Gerard of Frachet, and signed off on the definitive, standardized version of the liturgical *Legenda* of Saint Dominic."@en,
        "Quinto maestro generale dell'Ordine (1254-1263); riordinò e unificò la liturgia domenicana redigendo il \"Prototipo\" liturgico (1256-1260), promosse la stesura delle *Vitae fratrum* di Gerardo di Frachet e firmò la redazione definitiva e normalizzata della Legenda liturgica di san Domenico."@it ;
    crm:P107i_is_current_or_former_member_of :dominican_order,
        <https://www.wikidata.org/wiki/Q131479> ;
    owl:sameAs <https://www.wikidata.org/wiki/Q2623954> ;
    skos:exactMatch <https://viaf.org/en/viaf/122038877> ;
    arco-cd:isAuthorOf :legenda_humbertus ;
    rico:isOrWasLeaderOf :dominican_order,
        <https://www.wikidata.org/wiki/Q131479> .

