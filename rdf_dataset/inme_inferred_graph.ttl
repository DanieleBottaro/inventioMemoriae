        owl:NamedIndividual,
        rico:RecordPart ;
    rdfs:label "Dicta testium in inquisitione de vita et miraculis"@la ;
    lrmoo:R16i_was_created_by :bologna_inquiry_creation ;
    dcterms:description "It compiles the official records containing the direct testimonies of eyewitnesses (both the friars in Bologna and the witnesses in Toulouse)."@en,
        "Raccoglie i verbali ufficiali con le deposizioni dirette dei testimoni oculari (sia i frati a Bologna sia i testimoni a Tolosa)"@it ;
    dcterms:identifier <urn:clavis:bhl:2208> ;
    dcterms:language "la" ;
    dcterms:title "Dicta testium in inquisitione de vita et miraculis"@la ;
    crm:P148i_is_component_of :acta_canonizationis ;
    rico:isDirectConstituentOf :acta_canonizationis .

:nicola_workshop a crm:E74_Group,
        owl:NamedIndividual,
        rico:Group ;
    rdfs:label "Nicola Pisano's workshop"@en,
        "Atelier di Nicola Pisano"@it ;
    dcterms:description "A sculptural workshop, active primarily in Pisa, responsible for the design (c. 1264) and execution of the Shrine of Saint Dominic. Under Nicola's direction, the project involved the extensive and crucial participation of prominent assistants such as Arnolfo di Cambio, Lapo, and the Dominican friar Guglielmo."@en,
        "Bottega scultorea, attiva principalmente a Pisa, responsabile della progettazione (c. 1264) e dell'esecuzione dell'Arca di San Domenico . Sotto la direzione di Nicola, il cantiere dell'opera vide l'ampia e fondamentale partecipazione di assistenti di spicco quali Arnolfo di Cambio, Lapo e il frate domenicano Guglielmo."@it ;
    crm:P107_has_current_or_former_member :nicola_pisano,
        <https://www.wikidata.org/wiki/Q364413> ;
    crm:P11i_participated_in :creation_dominic_sarcophagus ;
    crm:P14i_performed :creation_dominic_sarcophagus ;
    rico:hasOrHadLeader :nicola_pisano,
        <https://www.wikidata.org/wiki/Q364413> .

:pope_innocent_iii a crm:E21_Person,
        owl:NamedIndividual,
        rico:Person ;
    rdfs:label "Pope Innocent III"@en,
        "Papa Innocenzo III"@it ;
    dcterms:description "The Pontiff who welcomed Saint Dominic to Rome in 1215 and, struck by the famous prophetic dream in which the saint was seen propping up the tottering Lateran Basilica, granted the Order its initial oral and preliminary approval."@en,
        "Pontefice che nel 1215 accolse san Domenico a Roma e, colpito dal celebre sogno premonitore in cui il santo sosteneva la basilica del Laterano pericolante, concesse la prima approvazione orale e preliminare all'Ordine."@it ;
    crm:P11i_participated_in :approval_order_request ;
    crm:P129i_is_subject_of :legenda_constantini,
        :legenda_humbertus,
        :theme_lateran_dream ;
    crm:P138i_has_representation :vi_detail_innocent_iii_receiving_scroll,
        :vi_detail_lateran_dream ;
    owl:sameAs <https://www.wikidata.org/wiki/Q128076> ;
    skos:exactMatch <https://viaf.org/en/viaf/16017787> .

:san_domenico_church a crm:E24_Physical_human-made_thing,
        crm:E53_Place,
        owl:NamedIndividual ;
    rdfs:label "Basilica of San Domenico"@en,
        "Basilica of San Domenico"@it ;
    dcterms:description "Solemnly consecrated in 1251, it stands on the site of the earlier church of San Niccolò delle Vigne. It is the Bolognese basilica designated to house and honor the new tomb containing the relics of Saint Dominic following their solemn translation in May 1233. It became a vital civic and religious landmark for the city, with its cloister and church serving as the burial place for distinguished figures from the academic, civil, and ecclesiastical spheres."@en,
        "Consacrata solennemente nel 1251, sorge sul sito della primitiva chiesa di San Niccolò delle Vigne. È la basilica bolognese destinata a custodire ed esaltare la nuova tomba con le reliquie di san Domenico dopo la solenne traslazionedel maggio 1233. Divenne un importantissimo punto di riferimento civico e religioso per la città, ospitando nel suo chiostro e nella chiesa le sepolture di illustri esponenti accademici, civili ed ecclesiastici."@it ;
    crm:P123i_resulted_from :Niccolo_to_Domenico_church_transformation ;
    crm:P89_falls_within :bologna,
        <https://sws.geonames.org/3181928>,
        <https://www.wikidata.org/wiki/Q1891> ;
    owl:sameAs <https://www.wikidata.org/wiki/Q862602> ;
    skos:exactMatch <https://viaf.org/en/viaf/316395384> .

