#################################################################
#    Annotation properties
#################################################################

dcterms:description a owl:AnnotationProperty .

dcterms:identifier a owl:AnnotationProperty .

dcterms:language a owl:DatatypeProperty .

dcterms:title a owl:DatatypeProperty .

crm:P106_is_composed_of a owl:AnnotationProperty .

crm:P108_has_produced a owl:AnnotationProperty .

#################################################################
#    Datatypes
#################################################################
### 

xsd:date a rdfs:Datatype .

xsd:gYear a rdfs:Datatype .

<internal:anonymous-constants> a rdfs:Datatype .

#################################################################
#    Object Properties
#################################################################
###

lrmoo:R16_created a owl:ObjectProperty ;
    owl:inverseOf lrmoo:R16i_was_created_by .

lrmoo:R1_is_logical_successor_of a owl:ObjectProperty,
        owl:TransitiveProperty ;
    owl:inverseOf lrmoo:R1i_has_successor .

lrmoo:R68_is_inspired_by a owl:ObjectProperty ;
    owl:inverseOf lrmoo:R68i_is_inspiration_for .

dcterms:creator a owl:ObjectProperty ;
    owl:inverseOf arco-cd:isAuthorOf .

crm:P123_resulted_in a owl:ObjectProperty ;
    owl:inverseOf crm:P123i_resulted_from .

crm:P124_transformed a owl:ObjectProperty ;
    owl:inverseOf crm:P124i_was_transformed_by .

crm:P129_is_about a owl:ObjectProperty,
        owl:TransitiveProperty ;
    owl:inverseOf crm:P129i_is_subject_of .

crm:P148_has_component a owl:ObjectProperty ;
    owl:inverseOf crm:P148i_is_component_of .

crm:P4_has_time-span a owl:ObjectProperty ;
    owl:inverseOf crm:P4i_is_time-span_of .

crm:P53_hasFormerOrCurrentLocation a owl:AnnotationProperty .

crm:P53_has_former_or_current_location a owl:ObjectProperty ;
    owl:inverseOf crm:P53i_is_former_or_current_location_of .

crm:P67_refers_to a owl:ObjectProperty ;
    owl:inverseOf crm:P67i_is_referred_to_by .

crm:P7_took_place_at a owl:ObjectProperty ;
    owl:inverseOf crm:P7i_witnessed .

crm:P82_at_some_time_within a owl:DatatypeProperty .

crm:P82a_begin_of_the_begin a owl:DatatypeProperty .

crm:P82b_end_of_the_end a owl:DatatypeProperty .

crm:P89_falls_within a owl:ObjectProperty ;
    owl:inverseOf crm:P89i_contains .

crm:P94_has_created a owl:ObjectProperty ;
    owl:inverseOf crm:P94i_was_created_by .

skos:altLabel a owl:DatatypeProperty .

skos:exactMatch a owl:AnnotationProperty .

: a owl:Ontology ;
    owl:versionIRI :1.0.0 .

:fanjeaux a crm:E53_Place,
        owl:NamedIndividual ;
    rdfs:label "Fanjeaux"@en,
        "Fanjeaux"@it ;
    dcterms:description "Place in which the official hagiographic tradition (beginning with Jordan of Saxony) rewrote and dramatized the miracle of the fire. It was transformed into a solemn public dispute before official adjudicators, in which Dominic’s orthodox book leapt unscathed from the flames three times."@en,
        "Scenario in cui la tradizione agiografica ufficiale (a partire da Giordano di Sassonia) riscrisse e teatralizzò il miracolo del fuoco. Venne trasformato in una disputa pubblica solenne davanti a giudici-arbitri ufficiali, in cui il libro ortodosso di Domenico balzò tre volte intatto dalle fiamme."@it ;
    owl:sameAs <https://sws.geonames.org/3019063>,
        <https://www.wikidata.org/wiki/Q198573> ;
    skos:exactMatch <https://viaf.org/en/viaf/126809850> .

arco:hasCulturalPropertyComponent a owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P46_is_composed_of ;
    owl:inverseOf arco:isCulturalPropertyComponentOf .

arco-cd:hasCommission a owl:ObjectProperty ;
    owl:inverseOf arco-cd:isCommissionOf .

arco-cd:hasCommittent a owl:ObjectProperty ;
    rdfs:subPropertyOf [ owl:inverseOf crm:P14i_performed ],
        crm:P14_carried_out_by ;
    owl:inverseOf arco-cd:isCommittentIn .

rico:creationWithRole a owl:ObjectProperty ;
    owl:inverseOf rico:roleIsContextOfCreationRelation .

rico:hasDirectConstituent a owl:ObjectProperty ;
    owl:inverseOf rico:isDirectConstituentOf .

rico:hasOrHadLeader a owl:ObjectProperty ;
    rdfs:subPropertyOf [ owl:inverseOf crm:P107i_is_current_or_former_member_of ],
        crm:P107_has_current_or_former_member ;
    owl:inverseOf rico:isOrWasLeaderOf .

rico:hasPart a owl:AnnotationProperty .

rico:isOrWasIncludedIn a owl:AnnotationProperty .

rico:relationHasSource a owl:ObjectProperty ;
    owl:inverseOf rico:thingIsSourceOfRelation .

rico:relationHasTarget a owl:ObjectProperty ;
    owl:inverseOf rico:thingIsTargetOfRelation .



