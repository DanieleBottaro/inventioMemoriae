:legenda_constantini a lrmoo:F1_Work,
        owl:NamedIndividual ;
    rdfs:label "Legenda Sancti Dominici"@la ;
    lrmoo:R16i_was_created_by :legenda_constantini_creation ;
    lrmoo:R1_is_logical_successor_of :legenda_petri_ferrandi,
        :libellus_principiis ;
    lrmoo:R1i_has_successor :legenda_humbertus ;
    lrmoo:R68_is_inspired_by :legenda_petri_ferrandi,
        :libellus_principiis ;
    lrmoo:R68i_is_inspiration_for :legenda_humbertus ;
    dcterms:creator :constantine_orvieto,
        <https://www.wikidata.org/wiki/Q108463017> ;
    dcterms:description "Approved in 1248, Constantine of Orvieto's \"Legenda Nova\" marks a decisive shift in Dominican memory, transforming the founder’s life from a historical chronicle into a systematic biography of wonders. While drawing heavily on Peter Ferrandi, Constantine omits many local details to project a more universal and prophetic image of Dominic. It is the first official source to stabilize the \"Miracle of the Loaves\" and to introduce pivotal institutional myths such as the Dream of the Lateran and the mandate from Peter and Paul which provided the Order with its definitive charismatic legitimacy and the primary narrative for its future iconographic programs."@en,
        "Approvata nel 1248, la \"Legenda Nova\" di Costantino di Orvieto segna una svolta decisiva nella memoria domenicana, trasformando la vita del fondatore da cronaca storica a biografia sistematica di prodigi. Pur attingendo ampiamente a Pietro Ferrandi, Costantino omette molti dettagli locali per proiettare un'immagine di Domenico più universale e profetica. Si tratta della prima fonte ufficiale a fissare il \"Miracolo dei pani\" e a introdurre miti istituzionali fondamentali, come il sogno del Laterano e il mandato di Pietro e Paolo, che conferirono all'Ordine la sua definitiva legittimazione carismatica e la narrazione primaria per i suoi futuri programmi iconografici."@it ;
    dcterms:language "la" ;
    dcterms:title "Legenda Sancti Dominici"@la ;
