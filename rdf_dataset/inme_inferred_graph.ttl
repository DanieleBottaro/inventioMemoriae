:dominic_guzman a crm:E21_Person,
        owl:NamedIndividual,
        rico:Person ;
    rdfs:label "Dominic de Guzmán"@en,
        "Domenico di Guzmán"@it ;
    dcterms:description "Canon of Osma, preacher against heresy in Languedoc, and founder of the Order of Preachers (Dominicans); he lived in strict evangelical poverty and died in Bologna in 1221."@en,
        "Canonico di Osma, predicatore antieretico in Linguadoca e fondatore dell'Ordine dei Frati Predicatori (Domenicani), vissuto in rigorosa povertà evangelica e morto a Bologna nel 1221."@it ;
